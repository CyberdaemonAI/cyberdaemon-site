---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import AmendmentBanner from '../../components/AmendmentBanner.astro';
import { getAmendments, getOriginalArticle } from '../../lib/amendments';

export async function getStaticPaths() {
  const entries = await getCollection('analysis', e => !e.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/\.(mdx|md)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const amendments = await getAmendments(entry.id);
const original = entry.data.updates ? await getOriginalArticle(entry.data.updates) : null;
---
<Article
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  lane="analysis"
  tags={entry.data.tags}
  threads={entry.data.threads}
  slug={entry.id.replace(/\.(mdx|md)$/, '')}
  collection="analysis"
>
  {original && <AmendmentBanner type="amends" articles={[original]} />}
  {amendments.length > 0 && <AmendmentBanner type="amended-by" articles={amendments} />}
  <Content />
</Article>
