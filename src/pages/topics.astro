---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const research  = (await getCollection('research',   e => !e.data.draft));
const analysis  = (await getCollection('analysis',   e => !e.data.draft));
const buildLogs = (await getCollection('build-logs', e => !e.data.draft));

type Article = { title: string; href: string; lane: string; topic: string; date: Date };

const allArticles: Article[] = [
  ...research.map(e  => ({ title: e.data.title, href: `/research/${e.slug}`, lane: 'research', topic: e.data.topic || 'Uncategorized', date: e.data.date })),
  ...analysis.map(e  => ({ title: e.data.title, href: `/analysis/${e.slug}`, lane: 'analysis', topic: e.data.topic || 'Uncategorized', date: e.data.date })),
  ...buildLogs.map(e => ({ title: e.data.title, href: `/build-logs/${e.slug}`, lane: 'build-logs', topic: e.data.topic || 'Uncategorized', date: e.data.date })),
];

// Group by topic, preserve topic ordering by earliest article date
const topicMap = new Map<string, Article[]>();
for (const a of allArticles) {
  if (!topicMap.has(a.topic)) topicMap.set(a.topic, []);
  topicMap.get(a.topic)!.push(a);
}

// Sort topics by earliest article date (oldest topic first = most foundational)
const topicOrder = [
  'Agentic AI Security',
  'AI Memory Systems',
  'Agentic Systems at Scale',
  'Zero Trust and Identity',
  'AI Governance and Compliance',
];

// Build final list: known topics first in order, then any new ones alphabetically
const knownTopics = topicOrder.filter(t => topicMap.has(t));
const unknownTopics = [...topicMap.keys()].filter(t => !topicOrder.includes(t)).sort();
const orderedTopics = [...knownTopics, ...unknownTopics];

// Sort articles within each topic by date descending
for (const [, articles] of topicMap) {
  articles.sort((a, b) => b.date.valueOf() - a.date.valueOf());
}

const laneColors: Record<string, string> = {
  'research':   'text-lane-research',
  'analysis':   'text-lane-analysis',
  'build-logs': 'text-lane-buildlog',
};

const laneLabels: Record<string, string> = {
  'research':   'R',
  'analysis':   'A',
  'build-logs': 'B',
};
---
<Base title="Topics" description="All cyberdaemon.ai content organized by topic.">
  <div class="max-w-article mx-auto px-6 py-16">

    <header class="mb-12">
      <p class="lane-tag mb-4">Index</p>
      <h1 class="font-serif text-title text-text-primary mb-4">Topics</h1>
      <p class="text-body text-text-secondary font-sans">
        All content organized by topic.
        <span class={`font-sans text-small ${laneColors['research']}`}>R</span> = Research,
        <span class={`font-sans text-small ${laneColors['analysis']}`}>A</span> = Analysis,
        <span class={`font-sans text-small ${laneColors['build-logs']}`}>B</span> = Build Log.
      </p>
    </header>

    <div class="flex flex-col gap-12">
      {orderedTopics.map(topicName => (
        <section>
          <h2 class="font-sans text-small font-semibold uppercase tracking-widest text-text-muted mb-4 border-b border-border pb-2">
            {topicName}
          </h2>
          <ul class="flex flex-col gap-3">
            {topicMap.get(topicName)!.map(item => (
              <li class="flex items-baseline gap-3">
                <span class={`font-sans text-label font-bold ${laneColors[item.lane]} shrink-0 w-3`}>
                  {laneLabels[item.lane]}
                </span>
                <a href={item.href} class="font-serif text-body text-text-primary hover:text-accent transition-colors">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="text-small text-text-muted font-sans mt-16 pt-6 border-t border-border">
      {allArticles.length} articles across {orderedTopics.length} topics. This page updates automatically.
    </p>

  </div>
</Base>
