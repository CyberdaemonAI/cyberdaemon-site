---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const research  = (await getCollection('research',   e => !e.data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const analysis  = (await getCollection('analysis',   e => !e.data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const buildLogs = (await getCollection('build-logs', e => !e.data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());

// Featured = first featured:true article across all lanes, or most recent research
const allArticles = [
  ...research.map(e  => ({ ...e, lane: 'research'   })),
  ...analysis.map(e  => ({ ...e, lane: 'analysis'   })),
  ...buildLogs.map(e => ({ ...e, lane: 'build-logs' })),
].sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = allArticles.find(e => e.data.featured) ?? allArticles[0] ?? null;

const laneColors: Record<string, string> = {
  'research':   '#6b8fcc',
  'analysis':   '#8fcc8a',
  'build-logs': '#cc9a6b',
};

const laneLabels: Record<string, string> = {
  'research':   'Research',
  'analysis':   'Analysis',
  'build-logs': 'Build Log',
};

function href(lane: string, slug: string) {
  return `/${lane}/${slug}`;
}

function fmt(d: Date) {
  return new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
}
---
<Base
  title="Casey Gager"
  description="Cybersecurity practitioner. Original research on agentic AI, identity, and Zero Trust."
>

  <!-- Hero -->
  <section class="max-w-article mx-auto px-6 pt-20 pb-16 border-b border-border">
    <h1 class="font-serif text-text-primary mb-4 leading-tight" style="font-size: 2.25rem; letter-spacing: -0.02em; max-width: 600px;">
      Casey Gager
    </h1>
    <p class="font-sans leading-relaxed mb-8" style="font-size: 1.0625rem; color: #666; max-width: 520px;">
      Cybersecurity practitioner. I build what I recommend, then write about what I find.
      Research on agentic AI authorization, episodic memory, and the governance frameworks
      that don't survive contact with reality.
    </p>
    <div class="flex items-center gap-6">
      <a href="/research" class="font-sans text-small hover:opacity-70 transition-opacity" style="color: #6b8fcc;">Research →</a>
      <a href="/topics"   class="font-sans text-small text-text-muted hover:text-text-secondary transition-colors">Topics →</a>
      <a href="/about"    class="font-sans text-small text-text-muted hover:text-text-secondary transition-colors">About →</a>
    </div>
  </section>

  <!-- Featured article -->
  {featured && (
    <section class="max-w-article mx-auto px-6 py-16 border-b border-border">
      <p class="lane-tag mb-6">Latest</p>
      <a href={href(featured.lane, featured.slug)} class="group block">
        <div class="article-meta mb-3">
          <span style={`color: ${laneColors[featured.lane]}`}>
            {laneLabels[featured.lane]}
          </span>
          <span class="sep">·</span>
          <time>{fmt(featured.data.date)}</time>
        </div>
        <h2 class="font-serif text-text-primary group-hover:text-accent transition-colors mb-3 leading-tight"
            style="font-size: 1.625rem; letter-spacing: -0.015em;">
          {featured.data.title}
        </h2>
        {featured.data.description && (
          <p class="font-sans leading-relaxed" style="font-size: 1rem; color: #666; max-width: 560px;">
            {featured.data.description}
          </p>
        )}
      </a>
    </section>
  )}

  <!-- Index: three lanes -->
  <section class="max-w-article mx-auto px-6 py-16">

    {research.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-7 border-b border-border pb-3">
          <span class="lane-tag research">Research</span>
          <a href="/research" class="font-sans text-small text-text-muted hover:text-text-secondary transition-colors">All →</a>
        </div>
        <div class="flex flex-col gap-8">
          {research.map(entry => (
            <a href={href('research', entry.slug)} class="group block">
              <h3 class="font-serif text-text-primary group-hover:text-accent transition-colors mb-1 leading-snug"
                  style="font-size: 1.125rem;">
                {entry.data.title}
              </h3>
              {entry.data.description && (
                <p class="font-sans text-text-secondary leading-relaxed mb-2" style="font-size: 0.9375rem;">
                  {entry.data.description}
                </p>
              )}
              <time class="font-sans text-text-muted" style="font-size: 0.8125rem;">{fmt(entry.data.date)}</time>
            </a>
          ))}
        </div>
      </div>
    )}

    {analysis.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-7 border-b border-border pb-3">
          <span class="lane-tag analysis">Analysis</span>
          <a href="/analysis" class="font-sans text-small text-text-muted hover:text-text-secondary transition-colors">All →</a>
        </div>
        <div class="flex flex-col gap-8">
          {analysis.map(entry => (
            <a href={href('analysis', entry.slug)} class="group block">
              <h3 class="font-serif text-text-primary group-hover:text-accent transition-colors mb-1 leading-snug"
                  style="font-size: 1.125rem;">
                {entry.data.title}
              </h3>
              {entry.data.description && (
                <p class="font-sans text-text-secondary leading-relaxed mb-2" style="font-size: 0.9375rem;">
                  {entry.data.description}
                </p>
              )}
              <time class="font-sans text-text-muted" style="font-size: 0.8125rem;">{fmt(entry.data.date)}</time>
            </a>
          ))}
        </div>
      </div>
    )}

    {buildLogs.length > 0 && (
      <div>
        <div class="flex items-center justify-between mb-7 border-b border-border pb-3">
          <span class="lane-tag buildlog">Build Logs</span>
          <a href="/build-logs" class="font-sans text-small text-text-muted hover:text-text-secondary transition-colors">All →</a>
        </div>
        <div class="flex flex-col gap-8">
          {buildLogs.map(entry => (
            <a href={href('build-logs', entry.slug)} class="group block">
              <h3 class="font-serif text-text-primary group-hover:text-accent transition-colors mb-1 leading-snug"
                  style="font-size: 1.125rem;">
                {entry.data.title}
              </h3>
              {entry.data.description && (
                <p class="font-sans text-text-secondary leading-relaxed mb-2" style="font-size: 0.9375rem;">
                  {entry.data.description}
                </p>
              )}
              <time class="font-sans text-text-muted" style="font-size: 0.8125rem;">{fmt(entry.data.date)}</time>
            </a>
          ))}
        </div>
      </div>
    )}

    {allArticles.length === 0 && (
      <p class="font-sans text-text-muted text-small">Articles loading.</p>
    )}

  </section>

</Base>
