---
import type { RelatedArticle } from '../lib/related-articles';

interface Props {
  articles: RelatedArticle[];
}
const { articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="related-articles">
    <h2>Related</h2>
    <ul>
      {articles.map((a) => (
        <li>
          <a href={`/${a.lane}/${a.slug}`}>{a.title}</a>
          <p>{a.description}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-articles {
    margin-top: 3rem;
    border-top: 1px solid var(--color-border, #e0e0e0);
    padding-top: 1.5rem;
  }
  .related-articles h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .related-articles ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .related-articles a {
    font-weight: 500;
    text-decoration: none;
  }
  .related-articles a:hover {
    text-decoration: underline;
  }
  .related-articles p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted, #666);
  }
</style>
