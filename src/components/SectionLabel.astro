---
/**
 * SectionLabel — uppercase label with extending line to fill remaining width.
 * Adapted from the loud-breach section-label pattern.
 *
 * Usage:
 *   <SectionLabel text="Attack Timeline" />
 *   <SectionLabel text="Recommendations" color="#c9a84c" />
 */

interface Props {
  text: string;
  color?: string;
}

const { text, color = '#00c8a0' } = Astro.props;
---

<div class="section-label font-mono" style={`color: ${color};`}>
  <span>{text}</span>
  <span class="section-line" style={`background: ${color}20;`}></span>
</div>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    margin-top: 3rem;
  }

  .section-line {
    flex: 1;
    height: 1px;
  }
</style>
