---
/**
 * Callout — colored callout boxes for insights, warnings, critical alerts, notes.
 * Adapted from the loud-breach summary-box pattern: border-left 2px, rounded right
 * corners, uppercase label.
 * Colors resolved from CSS custom properties (theme-aware).
 *
 * Usage:
 *   <Callout variant="insight">Content here</Callout>
 *   <Callout variant="warning" label="Heads Up">Custom label</Callout>
 */

interface Props {
  variant?: 'insight' | 'warning' | 'critical' | 'note';
  type?: 'insight' | 'warning' | 'critical' | 'note';
  label?: string;
}

const { variant: variantProp, type, label } = Astro.props;
const variant = variantProp ?? type ?? 'note';

const defaultLabels: Record<string, string> = {
  insight:  'Insight',
  warning:  'Warning',
  critical: 'Critical',
  note:     'Note',
};

const displayLabel = label ?? defaultLabels[variant];
---

<aside
  class="callout"
  data-variant={variant}
  role="note"
>
  <div class="callout-label font-mono">
    {displayLabel}
  </div>
  <div class="callout-content font-sans">
    <slot />
  </div>
</aside>

<style>
  .callout {
    border-left: 2px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0 8px 8px 0;
    padding: 1.5rem 1.75rem;
    margin: 2rem 0;
    background: var(--callout-note-bg);
  }

  /* Variant-specific left border and background */
  .callout[data-variant="insight"] {
    border-left-color: var(--color-lane-research);
    background: var(--callout-insight-bg);
  }
  .callout[data-variant="warning"] {
    border-left-color: var(--color-lane-analysis);
    background: var(--callout-warning-bg);
  }
  .callout[data-variant="critical"] {
    border-left-color: #c1121f;
    background: var(--callout-critical-bg);
  }
  .callout[data-variant="note"] {
    border-left-color: var(--color-border);
    background: var(--callout-note-bg);
  }

  .callout-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
  }

  .callout[data-variant="insight"] .callout-label  { color: var(--color-lane-research); }
  .callout[data-variant="warning"] .callout-label  { color: var(--color-lane-analysis); }
  .callout[data-variant="critical"] .callout-label { color: #c1121f; }

  .callout-content {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .callout-content :global(p) {
    margin-bottom: 0.5rem;
  }

  .callout-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .callout-content :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .callout-content :global(code) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    background: var(--color-bg-code-inline);
    border: 1px solid var(--color-border);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    color: var(--color-text-secondary);
  }
</style>
