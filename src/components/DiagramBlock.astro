---
/**
 * DiagramBlock — wrapper for Mermaid diagrams, Excalidraw sketches, or AI illustrations.
 *
 * type="mermaid" (default): Mermaid diagram rendered client-side. Inner div carries .mermaid class.
 * type="sketch":            Excalidraw SVG export. src prop required.
 * type="illustration":      AI-directed narrative image. src prop required.
 *
 * All three types share the dark card container and caption treatment.
 * public/images/ stores files; /images/ is the MDX URL (Astro public/ convention).
 *
 * Usage:
 *   <DiagramBlock caption="Attack chain">
 *     graph LR
 *       A[Token Theft] --> B[Lateral Movement]
 *   </DiagramBlock>
 *
 *   <DiagramBlock type="sketch" src="/images/context-flow.svg" caption="Context flow" />
 *
 *   <DiagramBlock type="illustration" src="/images/daemon-terminal.webp"
 *     caption="3am, terminal open" alt="A daemon at a terminal" />
 *
 * See docs/DIAGRAM-GUIDE.md for tier decision criteria, Mermaid templates,
 * Excalidraw export settings, and illustration brief format.
 */

interface Props {
  type?: 'mermaid' | 'sketch' | 'illustration';
  src?: string;
  caption?: string;
  alt?: string;
}

const { type = 'mermaid', src, caption, alt = '' } = Astro.props;
---

<figure class="diagram-block">
  {type === 'mermaid' && (
    <div class="diagram-inner mermaid">
      <slot />
    </div>
  )}
  {(type === 'sketch' || type === 'illustration') && src && (
    <div class={`diagram-inner diagram-${type}`}>
      <img src={src} alt={alt} loading="lazy" />
    </div>
  )}
  {caption && (
    <figcaption class="diagram-caption font-mono">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .diagram-block {
    margin: 2.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg-surface);
  }

  .diagram-inner {
    padding: 2rem 1.5rem;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  /* Mermaid: hide shiki pre/code before client JS runs */
  .diagram-inner.mermaid :global(pre) {
    display: none;
  }

  /* Mermaid: override SVG white background — scoped to .mermaid to avoid bleeding into sketch SVGs */
  .diagram-inner.mermaid :global(svg) {
    max-width: 100%;
    height: auto;
  }

  /* Sketch: SVG fills container */
  .diagram-sketch img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Illustration: image fills container, slight rounding */
  .diagram-illustration img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .diagram-caption {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }
</style>
