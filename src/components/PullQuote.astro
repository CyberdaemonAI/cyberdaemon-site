---
/**
 * PullQuote — serif italic quote with teal accent border.
 * Adapted from the loud-breach pull-quote pattern.
 *
 * Usage:
 *   <PullQuote>
 *     The breach was not sophisticated. The response was.
 *   </PullQuote>
 */
---

<blockquote class="pull-quote font-serif">
  <slot />
</blockquote>

<style>
  .pull-quote {
    margin: 2.5rem 0;
    padding: 1.5rem 2rem;
    border-left: 2px solid #00c8a0;
    background: rgba(0, 200, 160, 0.04);
    border-radius: 0 6px 6px 0;
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.6;
    color: #e8e5de;
  }

  .pull-quote :global(p) {
    margin: 0;
  }

  .pull-quote :global(cite) {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-style: normal;
    font-family: 'IBM Plex Mono', monospace;
    color: #706e68;
    letter-spacing: 0.02em;
  }
</style>
