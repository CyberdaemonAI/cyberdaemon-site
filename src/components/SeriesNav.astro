---
/**
 * SeriesNav — thread-aware series navigation.
 * Shows "Part N of M in [Thread]" with prev/next article links.
 * Appears above and below article body on any article with threads set.
 *
 * Usage (from Article.astro):
 *   <SeriesNav threads={threads} currentSlug={slug} collection={collection} />
 */
import { getCollection } from 'astro:content';

interface Props {
  threads: string[];
  currentSlug: string;
  collection: 'research' | 'analysis' | 'build-logs';
}

const { threads, currentSlug, collection } = Astro.props;

if (!threads || threads.length === 0) {
  // Render nothing — handled below via conditional
}

// Build label from thread slug: "cognitive-security" → "Cognitive Security"
function threadLabel(t: string) {
  return t.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join(' ');
}

const primaryThread = threads[0] ?? '';
const label = threadLabel(primaryThread);

type SeriesEntry = { title: string; slug: string; href: string; date: Date };

const research   = threads.length ? await getCollection('research',   e => !e.data.draft && (e.data.threads ?? []).some(t => threads.includes(t))) : [];
const analysis   = threads.length ? await getCollection('analysis',   e => !e.data.draft && (e.data.threads ?? []).some(t => threads.includes(t))) : [];
const buildLogs  = threads.length ? await getCollection('build-logs', e => !e.data.draft && (e.data.threads ?? []).some(t => threads.includes(t))) : [];

const allInThread: SeriesEntry[] = [
  ...research.map(e  => ({ title: e.data.title, slug: e.slug, href: `/research/${e.slug}`,    date: e.data.date })),
  ...analysis.map(e  => ({ title: e.data.title, slug: e.slug, href: `/analysis/${e.slug}`,    date: e.data.date })),
  ...buildLogs.map(e => ({ title: e.data.title, slug: e.slug, href: `/build-logs/${e.slug}`,  date: e.data.date })),
];

// Sort by date ASC, then slug ASC for same-date (preserves part1 → part2 → ... ordering)
allInThread.sort((a, b) => {
  const d = a.date.valueOf() - b.date.valueOf();
  return d !== 0 ? d : a.slug.localeCompare(b.slug);
});

const idx   = allInThread.findIndex(e => e.slug === currentSlug);
const total = allInThread.length;
const pos   = idx + 1;
const prev  = idx > 0 ? allInThread[idx - 1] : null;
const next  = idx < total - 1 ? allInThread[idx + 1] : null;
---

{threads.length > 0 && total > 1 && (
  <nav class="series-nav" aria-label={`${label} series navigation`}>
    <div class="series-meta">
      <a href={`/threads/${primaryThread}`} class="series-thread-link">
        {label}
      </a>
      <span class="series-position">Part {pos} of {total}</span>
    </div>
    <div class="series-links">
      {prev ? (
        <a href={prev.href} class="series-link series-prev" rel="prev">
          <span class="series-dir">← Previous</span>
          <span class="series-title">{prev.title}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={next.href} class="series-link series-next" rel="next">
          <span class="series-dir">Next →</span>
          <span class="series-title">{next.title}</span>
        </a>
      ) : <div />}
    </div>
  </nav>
)}

<style>
  .series-nav {
    border-top: 1px solid #2e2c29;
    border-bottom: 1px solid #2e2c29;
    padding: 1.25rem 0;
    margin: 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .series-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .series-thread-link {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b9e9e;
    text-decoration: none;
    border: 1px solid #2e2c29;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    transition: border-color 0.15s, color 0.15s;
  }

  .series-thread-link:hover {
    border-color: #6b9e9e;
    color: #8bbcbc;
  }

  .series-position {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: #706e68;
  }

  .series-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .series-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    padding: 0.75rem;
    border: 1px solid #2e2c29;
    border-radius: 6px;
    background: #16150f;
    transition: border-color 0.15s, background 0.15s;
  }

  .series-link:hover {
    border-color: #4a4840;
    background: #1a1917;
  }

  .series-next {
    text-align: right;
  }

  .series-dir {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #706e68;
  }

  .series-title {
    font-family: var(--font-sans, ui-sans-serif, sans-serif);
    font-size: 0.875rem;
    color: #b0ada6;
    line-height: 1.4;
  }

  .series-link:hover .series-title {
    color: #d4d0c8;
  }
</style>
