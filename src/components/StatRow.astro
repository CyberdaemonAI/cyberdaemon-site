---
/**
 * StatRow — 3-column stat grid with serif numbers and mono labels.
 * Adapted from the loud-breach stat-row pattern.
 *
 * Usage:
 *   <StatRow stats={[
 *     { value: '110K', label: 'API keys exposed' },
 *     { value: '36h', label: 'Time to detection' },
 *     { value: '14', label: 'Compromised repos' },
 *   ]} />
 */

interface StatItem {
  value: string;
  label: string;
}

interface Props {
  stats: StatItem[];
}

const { stats } = Astro.props;
---

<div class="stat-row">
  {stats.map((stat) => (
    <div class="stat-cell">
      <span class="stat-value font-serif">{stat.value}</span>
      <span class="stat-label font-mono">{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid #2e2c29;
    border-radius: 8px;
    overflow: hidden;
    margin: 2.5rem 0;
    background: #1a1917;
  }

  .stat-cell {
    padding: 1.75rem 1.5rem;
    border-right: 1px solid #2e2c29;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-value {
    font-size: 2.75rem;
    font-weight: 700;
    color: #00c8a0;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #706e68;
  }

  @media (max-width: 640px) {
    .stat-row {
      grid-template-columns: 1fr;
    }

    .stat-cell {
      border-right: none;
      border-bottom: 1px solid #2e2c29;
      padding: 1.25rem 1.5rem;
    }

    .stat-cell:last-child {
      border-bottom: none;
    }
  }
</style>
