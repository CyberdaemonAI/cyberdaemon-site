---
import Base from './Base.astro';
import ArticleHero from '../components/ArticleHero.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  lane: 'research' | 'analysis' | 'build-logs';
  tags?: string[];
  readTime?: string;
}

const { title, description, date, lane, tags = [], readTime } = Astro.props;
---
<Base title={title} description={description}>

  <article class="max-w-article mx-auto px-6 pb-24">

    <ArticleHero
      title={title}
      subtitle={description}
      lane={lane}
      date={date}
      readTime={readTime}
    />

    <!-- Body -->
    <div class="article-body">
      <slot />
    </div>

  </article>

</Base>
