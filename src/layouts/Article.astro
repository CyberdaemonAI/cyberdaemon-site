---
import Base from './Base.astro';
import ArticleHero from '../components/ArticleHero.astro';
import SeriesNav from '../components/SeriesNav.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  lane: 'research' | 'analysis' | 'build-logs';
  tags?: string[];
  readTime?: string;
  threads?: string[];
  slug?: string;
  collection?: 'research' | 'analysis' | 'build-logs';
}

const { title, description, date, lane, tags = [], readTime, threads = [], slug = '', collection = lane } = Astro.props;
---
<Base title={title} description={description}>

  <article class="max-w-article mx-auto px-6 pb-24">

    <ArticleHero
      title={title}
      subtitle={description}
      lane={lane}
      date={date}
      readTime={readTime}
    />

    {threads.length > 0 && slug && (
      <SeriesNav threads={threads} currentSlug={slug} collection={collection} />
    )}

    <!-- Body -->
    <div class="article-body">
      <slot />
    </div>

    {threads.length > 0 && slug && (
      <SeriesNav threads={threads} currentSlug={slug} collection={collection} />
    )}

  </article>

</Base>
