---
import Base from './Base.astro';
import ArticleHero from '../components/ArticleHero.astro';
import AuthorCard from '../components/AuthorCard.astro';
import SeriesNav from '../components/SeriesNav.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getRelatedArticles } from '../lib/related-articles';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  lane: 'research' | 'analysis' | 'build-logs';
  tags?: string[];
  readTime?: string;
  threads?: string[];
  slug?: string;
  collection?: 'research' | 'analysis' | 'build-logs';
  hideAuthorCard?: boolean;
  headings?: Heading[];
}

const { title, description, date, lane, tags = [], readTime, threads = [], slug = '', collection = lane, hideAuthorCard = false, headings = [] } = Astro.props;

const ogImage = slug
  ? `https://cyberdaemon.ai/api/og.png?slug=${encodeURIComponent(slug)}&lane=${encodeURIComponent(lane)}&title=${encodeURIComponent(title)}`
  : undefined;

const related = slug
  ? await getRelatedArticles(slug, lane, tags, threads)
  : [];

const hasToc = headings.filter(h => h.depth >= 2 && h.depth <= 3).length > 0;
---
<Base title={title} description={description} ogImage={ogImage}>

  <article class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 pb-24">

    <ArticleHero
      title={title}
      subtitle={description}
      lane={lane}
      date={date}
      readTime={readTime}
    />

    {threads.length > 0 && slug && (
      <SeriesNav threads={threads} currentSlug={slug} collection={collection} />
    )}

    <div class:list={["article-wrap", { 'article-wrap--with-toc': hasToc }]}>
      <div class="article-body prose-container">
        <slot />
      </div>
      {hasToc && (
        <aside class="article-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </div>

    {threads.length > 0 && slug && (
      <SeriesNav threads={threads} currentSlug={slug} collection={collection} />
    )}

    <RelatedArticles articles={related} />

    {!hideAuthorCard && <AuthorCard />}

  </article>

</Base>
