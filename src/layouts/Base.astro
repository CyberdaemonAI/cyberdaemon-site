---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Casey Gager — AI security practitioner and researcher.', ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Flash prevention: apply saved theme before first paint -->
  <script is:inline>
    (function() {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
      } catch (_) {}
    })();
  </script>
  <link rel="canonical" href={canonical} />
  <title>{title} — cyberdaemon.ai</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <link rel="me" href="https://www.linkedin.com/company/cyberdaemonai" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage
    ? <meta name="twitter:card" content="summary_large_image" />
    : <meta name="twitter:card" content="summary" />
  }
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,300;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="cyberdaemon.ai" href="/rss.xml" />
  <!-- Plausible Analytics -- privacy-first, no cookies, GDPR-compliant -->
  {import.meta.env.PROD && (
    <script
      defer
      data-domain="cyberdaemon.ai"
      src="https://plausible.io/js/script.js"
    />
  )}
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    const THEME_VARS = {
      dark: {
        theme: 'dark',
        darkMode: true,
        themeVariables: {
          background: '#0f0f0f',
          primaryColor: '#1a1917',
          primaryTextColor: '#e8e5de',
          primaryBorderColor: '#2e2c29',
          lineColor: '#706e68',
          secondaryColor: '#21201e',
          tertiaryColor: '#1a1917',
          edgeLabelBackground: '#1a1917',
          clusterBkg: '#1a1917',
          clusterBorder: '#2e2c29',
          fontFamily: 'IBM Plex Mono, monospace',
          fontSize: '13px',
        }
      },
      light: {
        theme: 'default',
        darkMode: false,
        themeVariables: {
          background: '#f7f4ef',
          primaryColor: '#efe9e0',
          primaryTextColor: '#1a1815',
          primaryBorderColor: '#d4cfc8',
          lineColor: '#6b6560',
          secondaryColor: '#e8e0d5',
          tertiaryColor: '#efe9e0',
          edgeLabelBackground: '#efe9e0',
          clusterBkg: '#efe9e0',
          clusterBorder: '#d4cfc8',
          fontFamily: 'IBM Plex Mono, monospace',
          fontSize: '13px',
        }
      }
    };

    function currentThemeKey() {
      return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    }

    async function renderDiagrams() {
      const nodes = Array.from(document.querySelectorAll('.diagram-inner'));
      if (nodes.length === 0) return;

      // Restore raw source (or capture it on first run) and clear rendered SVGs
      nodes.forEach(diagram => {
        const saved = diagram.getAttribute('data-diagram-src');
        if (saved) {
          // Re-render: restore raw text, remove mermaid's processed marker
          diagram.textContent = saved;
          diagram.removeAttribute('data-processed');
        } else {
          // First run: Astro/shiki may have wrapped the syntax in <pre><code>
          const raw = diagram.textContent.trim();
          if (raw) {
            diagram.setAttribute('data-diagram-src', raw);
            diagram.textContent = raw;
          }
        }
      });

      mermaid.initialize({ startOnLoad: false, ...THEME_VARS[currentThemeKey()] });
      await mermaid.run({ nodes, suppressErrors: true });
    }

    document.addEventListener('DOMContentLoaded', renderDiagrams);
    document.addEventListener('astro:page-load', renderDiagrams);

    // Re-render diagrams when ThemeToggle fires theme-changed
    document.addEventListener('theme-changed', renderDiagrams);
  </script>
</head>
<body class="bg-bg text-text-primary">

  <header class="border-b border-border">
    <nav class="max-w-site mx-auto px-6 h-14 flex items-center justify-between">
      <a href="/" class="font-sans text-small font-semibold tracking-tight hover:text-accent transition-colors">
        cyberdaemon.ai
      </a>
      <div class="flex items-center gap-6">
        <a href="/research" class="text-small text-text-secondary hover:text-lane-research transition-colors">Research</a>
        <a href="/analysis" class="text-small text-text-secondary hover:text-lane-analysis transition-colors">Analysis</a>
        <a href="/build-logs" class="text-small text-text-secondary hover:text-lane-buildlog transition-colors">Build Logs</a>
        <a href="/about" class="text-small text-text-secondary hover:text-text-primary transition-colors">About</a>
        <a
          href="https://www.linkedin.com/company/cyberdaemonai"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="nav-social-icon"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://github.com/CyberdaemonAI"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="nav-social-icon"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-border mt-24">
    <div class="max-w-site mx-auto px-6 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="text-small text-text-muted">
        &copy; {new Date().getFullYear()} cyberdaemon.ai
      </div>
      <div class="flex items-center gap-6 text-small text-text-muted">
        <a href="/research" class="hover:text-text-secondary transition-colors">Research</a>
        <a href="/analysis" class="hover:text-text-secondary transition-colors">Analysis</a>
        <a href="/build-logs" class="hover:text-text-secondary transition-colors">Build Logs</a>
        <a
          href="https://www.linkedin.com/company/cyberdaemonai"
          class="hover:text-accent transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="cyberdaemon.ai on LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://github.com/CyberdaemonAI"
          class="hover:text-accent transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CyberdaemonAI on GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="currentColor"
            aria-hidden="true"
          >
            <!-- GitHub mark (Octicon github-mark-16) -->
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
          </svg>
        </a>
      </div>
    </div>
  </footer>

</body>
</html>
